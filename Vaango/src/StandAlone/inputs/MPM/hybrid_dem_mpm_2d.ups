<?xml version='1.0' encoding='ISO-8859-1' ?>
<Uintah_specification>

   <Meta>
       <title>Hybrid DEM-MPM Compaction of cylinders</title>
   </Meta>

   <SimulationComponent type="mpm" />

   <Time>
       <maxTime>1.0</maxTime>
       <initTime>0.0</initTime>
       <delt_min>0.0001</delt_min>
       <delt_max>0.001</delt_max>
       <timestep_multiplier>0.1</timestep_multiplier>
   </Time>

   <DataArchiver>
       <filebase>hybrid_dem_mpm_2d.uda</filebase>
       <outputInterval>0.05</outputInterval>
       <save label = "p.x"/>
       <save label = "p.velocity"/>
       <save label = "p.externalforce"/>
       <save label = "p.angularVelocity"/>
       <save label = "p.torque"/>
       <save label = "p.rigidBodyID"/>
       <save label = "g.mass"/>
       <save label = "g.velocity"/>
   </DataArchiver>

    <MPM>
       <time_integrator>explicit</time_integrator>
       <enable_dem>true</enable_dem>
    </MPM>

    <PhysicalConstants>
       <gravity>[0,0,0]</gravity>
    </PhysicalConstants>

    <MaterialProperties>
       <MPM>
            <!-- Continuum Piston -->
            <material name = "Piston">
                <density>1.9e6</density>
                <constitutive_model type = "hypo_elastic"> 
                    <G>7.2e4</G>
                    <K>10.2e4</K>
                </constitutive_model>
                <thermal_conductivity>1.0e-7</thermal_conductivity>
                <specific_heat>1.004e-5</specific_heat>
                <geom_object>
                    <box label = "piston">
                        <min>[0.0, 0.0, 4.0]</min>
                        <max>[1.0, 0.0125, 4.1]</max>
                    </box>
                    <res>[1,1,1]</res>
                    <velocity>[0.0, 0.0, -0.1]</velocity>
                    <temperature>300</temperature>
                </geom_object>
            </material>

            <!-- Continuum Disks -->
            <material name = "ContinuumHMX">
                <density>1.9e6</density>
                <constitutive_model type = "hypo_elastic"> 
                    <G>7.2e5</G>
                    <K>10.2e5</K>
                </constitutive_model>
                <thermal_conductivity>1.0e-7</thermal_conductivity>
                <specific_heat>1.004e-5</specific_heat>
                <geom_object>
                    <cylinder label = "cyl1">
                        <bottom>[0.5, 0.0, 0.5]</bottom>
                        <top>[0.5, 0.0125, 0.5]</top>
                        <radius> 0.5 </radius>
                    </cylinder>
                    <res>[2,1,2]</res>
                    <velocity>[0.0, 0.0, 0.0]</velocity>
                    <temperature>300</temperature>
                </geom_object>
                <geom_object>
                    <cylinder label = "cyl2">
                        <bottom>[0.5, 0.0, 1.5]</bottom>
                        <top>[0.5, 0.0125, 1.5]</top>
                        <radius> 0.5 </radius>
                    </cylinder>
                    <res>[2,1,2]</res>
                    <velocity>[0.0, 0.0, 0.0]</velocity>
                    <temperature>300</temperature>
                </geom_object>
            </material>

            <!-- Discrete DEM Disks -->
            <material name = "DiscreteHMX">
                <density>1.9e6</density>
                <constitutive_model type = "hypo_elastic"> 
                    <G>7.2e5</G>
                    <K>10.2e5</K>
                </constitutive_model>
                <thermal_conductivity>1.0e-7</thermal_conductivity>
                <specific_heat>1.004e-5</specific_heat>
                
                <is_dem_material>true</is_dem_material>
                <radius>0.5</radius>
                <kn>1.0e8</kn>
                <kt>1.0e7</kt>
                <mu>0.5</mu>
                <gamma>0.1</gamma>

                <geom_object>
                    <cylinder label = "cyl3">
                        <bottom>[0.5, 0.0, 2.5]</bottom>
                        <top>[0.5, 0.0125, 2.5]</top>
                        <radius> 0.5 </radius>
                    </cylinder>
                    <res>[1,1,1]</res> <!-- Low resolution to treat as single particle if possible -->
                    <velocity>[0.0, 0.0, 0.0]</velocity>
                    <temperature>300</temperature>
                </geom_object>
                <geom_object>
                    <cylinder label = "cyl4">
                        <bottom>[0.5, 0.0, 3.5]</bottom>
                        <top>[0.5, 0.0125, 3.5]</top>
                        <radius> 0.5 </radius>
                    </cylinder>
                    <res>[1,1,1]</res>
                    <velocity>[0.0, 0.0, 0.0]</velocity>
                    <temperature>300</temperature>
                </geom_object>
            </material>

            <contact>
                <type>null</type>
                <materials>[0,1,2]</materials>
            </contact>
       </MPM>
    </MaterialProperties>
       
    <Grid>
       <BoundaryConditions>
                <Face side = "x-">
                    <BCType id = "all" var = "symmetry" label = "Symmetric"> </BCType>
                </Face>
                <Face side = "x+">
                    <BCType id = "all" var = "symmetry" label = "Symmetric"> </BCType>
                </Face>
                <Face side = "y-">
                    <BCType id = "all" var = "symmetry" label = "Symmetric"> </BCType>
                </Face>                  
                <Face side = "y+">
                    <BCType id = "all" var = "symmetry" label = "Symmetric"> </BCType>
                </Face>
                <Face side = "z-">
                    <BCType id = "all" var = "symmetry" label = "Symmetric"> </BCType>
                </Face>
                <Face side = "z+">
                    <BCType id = "all" var = "symmetry" label = "Symmetric"> </BCType>
                </Face>
       </BoundaryConditions>
       <Level>
           <Box label = "1">
              <lower>[-0.0125, 0.0, 0.0]</lower>
              <upper>[1.0125, 0.0125, 4.2]</upper>
              <resolution>[20, 1, 84]</resolution>
              <patches>[1, 1, 1]</patches>
           </Box>
       </Level>
    </Grid>

</Uintah_specification>
